<?xml version="1.0" encoding="utf-8"?>
<!-- Passes (passes.json) and their logos (logos/) go along with backups and moves to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="passes.json" />
        <include domain="file" path="logos/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="passes.json" />
        <include domain="file" path="logos/" />
    </device-transfer>
</data-extraction-rules>
